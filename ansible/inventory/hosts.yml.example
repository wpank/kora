# Kora devnet Ansible inventory
#
# Copy this file to hosts.yml and fill in your values:
#   cp hosts.yml.example hosts.yml
#
# Requirements:
#   - Target must be Arch Linux (playbooks use pacman)
#   - SSH key-based authentication
#   - hosts.yml is gitignored to protect server IPs
#
# For first-time provisioning on a fresh Hetzner host, root SSH is expected.
# Provisioning creates the non-root kora service user used by deploy/operate
# playbooks. After bootstrapping, you may switch ansible_user to a separate
# pre-created sudo-capable login user if your host policy requires it.
all:
  children:
    devnet:
      hosts:
        hetzner-devnet:
          ansible_host: YOUR_SERVER_IP
          ansible_user: root
          ansible_python_interpreter: /usr/bin/python3
